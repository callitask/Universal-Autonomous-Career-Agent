# ==============================================================================
# UNIVERSAL AUTONOMOUS CAREER AGENT: .gitignore
# ==============================================================================

# 1. CRITICAL: SENSITIVE CANDIDATE DATA & DYNAMIC PROFILES DIRECTORY
# Block live candidate sandboxes to prevent PII/Resume leaks.
# EXCEPTION (2026-10-07): profiles/default_user/ is the canonical tracked schema
# blueprint (candidate_config.json, resume.md, cover_letter_template.md, README.md).
# All other profiles/*/ remain ignored. Never add a live profile to version control.
# NOTE: bare `profiles/` (without *) would block negation, so contents are ignored
# per-child to let the default_user exception take effect.
profiles/*
!profiles/default_user/
!profiles/.gitkeep
!profiles/README.md
# Blueprint runtime skeleton stays untracked even under the tracked blueprint.
profiles/default_user/output/


# 2. Python Environment & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.env
.venv
venv/
ENV/
env.bak/
venv.bak/

# 3. Playwright & Browser Artifacts
test-results/
.playwright-artifacts/
screenshots/

# 4. Logs, Audit Dumps, and Databases
*.log
*.sqlite3
output_*.json
*_dom_audit.json
dom_audit_*.json
*.tmp
*.bak
*.swp

# 5. Agent & IDE Caches / Scratch Directories
scratch/
.gemini/
logs_dump.txt
anshika_garg/
colab_credentials.json

# 6. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 7. Sibling Sophron repo (separate git history at F:\Sophron, model-agnostic intelligence)
# Sophron lives OUTSIDE this repo since 2026-09-22 extraction. Nothing nested to ignore.
# Local build artifacts that must never be committed:
scan_root.json
scan_sophron.json
*.zip

# 8. API Credentials & Secrets — NEVER commit these
gemini_credentials.json
colab_logic.txt

# 9. Company-site apply inspections — portal DOM scrapes may contain candidate PII
# (full name, email, phone captured from filled forms / ATS confirmation pages).
# These are runtime artifacts; never commit them.
CompanySiteApply/inspections/
CompanySiteApply/inspections/**

# 10. Knowledge index build artifacts — regenerable; may embed PII from profile content
# and machine-specific paths (e.g. F:\Sophron from index_meta.json). Rebuild with:
#   python scripts/build_knowledge_index.py --build
knowledge/vectors/
knowledge/graph/
