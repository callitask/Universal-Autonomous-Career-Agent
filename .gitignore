# 1. CRITICAL: SENSITIVE CANDIDATE DATA
# Completely block the profiles directory to prevent PII/Resume leaks
profiles/*
!profiles/.gitkeep

# 2. Python Environment & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.env
.venv
venv/
ENV/
env.bak/
venv.bak/

# 3. Playwright & Browser Artifacts
test-results/
.playwright-artifacts/

# 4. Logs and Databases
*.log
*.sqlite3

# 5. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini